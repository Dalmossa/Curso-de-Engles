{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "#domain/*": ["src/domain/*"],
      "#infrastructure/*": ["src/infrastructure/*"],
      "#modules/*": ["src/modules/*"],
      "#common/*": ["src/common/*"]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "types": ["jest", "node"]
  },
  "include": ["tests/**/*", "src/**/*", "express.d.ts"],
  "exclude": ["node_modules", "dist"]
}