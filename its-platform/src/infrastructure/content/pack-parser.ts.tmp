import type { PackRecord, PackItemRecord, PackItemOptionRecord } from './content-types.js';
import { parse as parseYaml } from 'yaml';

const MATCHING_KEY_UNSUPPORTED = new Set<string>([
  'vocab.clean_code.dry_yagni',
  'vocab.email.fyi_asap',
  'vocab.incident.runbook_oncall',
  'vocab.acronym.sla_slo_sli',
  'vocab.arch.latency_throughput',
  'vocab.project.risk_mitigation',
  'vocab.culture.punctuality',
  'vocab.culture.feedback',
]);

function normalizeOptionText(text: string): string {
  return text.replace(/\*\*/g, '').trim().toLowerCase();
}

export function parsePack(markdown: string, filename: string): PackRecord {
  const hasPackIdYaml = /^pack_id:/m.test(markdown);
  const hasLegacyPackId = /\*\*Pack ID:\*\*/i.test(markdown);
  if (!hasPackIdYaml && !hasLegacyPackId) {
    throw new Error(`Unknown pack schema in ${filename}`);
  }
  if (hasPackIdYaml) {
    return parseCanonicalPack(markdown, filename);
  }
  return parseLegacyPack(markdown, filename);
}

function parseCanonicalPack(markdown: string, filename: string): PackRecord {
  const lines = markdown.split(/\r?\n/);
  let yamlStart = -1;
  let yamlEnd = -1;
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    if (line && /^pack_id:/i.test(line.trim())) {
      yamlStart = i;
      break;
    }
  }
  if (yamlStart >= 0) {
    for (let i = yamlStart + 1; i < lines.length; i++) {
      const line = lines[i];
      if (!line) continue;
      if (/^#{1,3}\s/.test(line)) {
        yamlEnd = i;
        break;
      }
      if (line.trim() && !/^\s*[a-zA-Z_][a-zA-Z0-9_]*:/.test(line) && line[0] !== ' ' && line[0] !== '\t' && line[0] !== '-') {
        yamlEnd = i;
        break;
      }
    }
    if (yamlEnd === -1) yamlEnd = Math.min(lines.length, yamlStart + 30);
  }
  let meta: any = {};
  if (yamlStart >= 0 && yamlEnd > yamlStart) {
    try {
      const yamlStr = lines.slice(yamlStart, yamlEnd).join('\n');
      meta = parseYaml(yamlStr) as any;
    } catch (e) {
      // ignore
    }
  }
  const pack_id = meta.pack_id || (filename.match(/pack-les-[^.]+/)?.[0] ? filename.match(/pack-les-[^.]+/)![0].replace('.md', '') : '') || '';
  const lesson_id = meta.lesson_id || '';
  const cefr_level = meta.cefr_level || 'A2';
  const time_cap = meta.time_cap || 0;
  const split = meta.split || 'mixed';
  const interleaved = meta.interleaved !== false;
  const reuse_basis = meta.reuse_basis || 'cite_only';
  const items: PackItemRecord[] = [];
  const skips: Array<{ item_id: string; reason: string }> = [];
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    if (line && /^###\s+ITEM/i.test(line)) {
      const start = i;
      let end = lines.length;
      for (let j = i + 1; j < lines.length; j++) {
        const l2 = lines[j];
        if (!l2) continue;
        if (/^###\s+ITEM/i.test(l2) || /^##\s/.test(l2)) {
          end = j;
          break;
        }
      }
      const itemBlock = lines.slice(start, end).join('\n');
      const item = parseCanonicalItem(itemBlock);
      if (item) {
        if (MATCHING_KEY_UNSUPPORTED.has(item.item_id)) {
          skips.push({ item_id: item.item_id, reason: 'matching_key_unsupported' });
          continue;
        }
        items.push(item);
      }
    }
  }
  return {
    pack_id,
    lesson_id,
    title: meta.title || pack_id,
    cefr_level,
    time_cap,
    split,
    interleaved,
    reuse_basis,
    schema: 'canonical',
    items,
    skip_count: skips.length,
    skips,
  };
}

function parseCanonicalItem(block: string): PackItemRecord | null {
  const m1 = block.match(/\*\*item_id:\*\*\s*(.+)$/im);
  const item_id = m1 && m1[1] ? m1[1].trim() : '';
  if (!item_id) return null;
  const tMatch = block.match(/\*\*type:\*\*\s*(.+)$/im);
  const type = tMatch && tMatch[1] ? tMatch[1].trim() : '';
  const qMatch = block.match(/\*\*question:\*\*\s*(.+)$/im);
  const question = qMatch && qMatch[1] ? qMatch[1].trim() : undefined;
  const sMatch = block.match(/\*\*scoring:\*\*\s*(.+)$/im);
  const scoring = sMatch && sMatch[1] ? sMatch[1].trim() : undefined;
  const dMatch = block.match(/\*\*difficulty:\*\*\s*(.+)$/im);
  const difficulty = dMatch && dMatch[1] ? parseFloat(dMatch[1]) : 0;
  const options: PackItemOptionRecord[] = [];
  const tableRegex = /\| Slot \| Value \|[^\n]*\n[^\n]*\n((?:\|[^\n]*\n)*)/g;
  let tableMatch: RegExpExecArray | null;
  let lastTable = '';
  while ((tableMatch = tableRegex.exec(block)) !== null) {
    if (tableMatch[1]) lastTable = tableMatch[1];
  }
  if (lastTable) {
    const rows = lastTable.split(/\n/).filter((r) => r.trim() && r.includes('|'));
    for (const row of rows) {
      const cols = row.split('|');
      if (cols.length >= 4) {
        const slot = cols[1].trim();
        const value = cols[2].trim();
        if (slot) {
          const note = cols[3].trim();
          options.push({ slot, value, is_key: /\*\*/.test(slot) || slot.toLowerCase().includes('key'), note: note || undefined });
        }
      } else if (cols.length >= 3) {
        const slot = cols[1].trim();
        const value = cols[2].trim();
        if (slot) {
          options.push({ slot, value, is_key: /\*\*/.test(slot) || slot.toLowerCase().includes('key') });
        }
      }
    }
  }
  let type_mapped = type;
  if (type === 'multiple_choice' || type === 'contextual_selection') type_mapped = 'contextual_selection';
  else if (type.includes('minimal_pair')) type_mapped = 'minimal_pair';
  else if (type === 'defect_counting') type_mapped = 'scanning';
  else if (type === 'true_false_microtext' || type === 'checklist_completion') type_mapped = 'contextual_selection';
  const p_random = options.length > 0 ? Math.round((1 / options.length) * 10000) / 10000 : 1.0;
  return { item_id, type, type_mapped, question, scoring, difficulty, options, p_random };
}

function parseLegacyItem(block: string): PackItemRecord | null {
  const m1 = block.match(/\*\*item_id:\*\*\s*(.+)$/im);
  const m2 = block.match(/\*\*item_id\*\*:\s*(.+)$/im);
  const item_id = m1 && m1[1] ? m1[1].trim() : m2 && m2[1] ? m2[1].trim() : '';
  if (!item_id) return null;
  const tMatch = block.match(/\*\*type:\*\*\s*(.+)$/im);
  const type = tMatch && tMatch[1] ? tMatch[1].trim() : '';
  const qMatch = block.match(/\*\*Question:\*\*\s*(.+)$/im);
  const question = qMatch && qMatch[1] ? qMatch[1].trim() : undefined;
  const kMatch = block.match(/\*\*Key:\*\*\s*(.+)$/im);
  const key = kMatch && kMatch[1] ? kMatch[1].trim() : undefined;
  const bMatch = block.match(/\*\*br_pt_form:\*\*\s*(.+)$/im);
  const br_pt = bMatch && bMatch[1] ? bMatch[1].trim() : undefined;
  const options: PackItemOptionRecord[] = [];
  const tableRegex = /\| Slot \| Value \|[^\n]*\n[^\n]*\n((?:\|[^\n]*\n)*)/g;
  let tableMatch: RegExpExecArray | null;
  let lastTable = '';
  while ((tableMatch = tableRegex.exec(block)) !== null) {
    if (tableMatch[1]) lastTable = tableMatch[1];
  }
  if (lastTable) {
    const rows = lastTable.split(/\n/).filter((r) => r.trim() && r.includes('|'));
    for (const row of rows) {
      const cols = row.split('|');
      if (cols.length >= 3) {
        const slot = cols[1].trim();
        const value = cols[2].trim();
        if (slot && slot !== 'Slot') {
          const isKey = key ? normalizeOptionText(value) === normalizeOptionText(key) || /\*\*/.test(slot) : false;
          let note: string | undefined;
          if (cols.length >= 4) {
            const n = cols[3].trim();
            note = n || undefined;
          } else if (!isKey) {
            note = br_pt;
          }
          options.push({ slot, value, is_key: isKey, note, br_pt_form: br_pt });
        }
      }
    }
  }
  const p_random = options.length > 0 ? Math.round((1 / options.length) * 10000) / 10000 : 1.0;
  return { item_id, type, question, options, p_random };
}

function parseLegacyPack(markdown: string, filename: string): PackRecord {
  const lines = markdown.split(/\r?\n/);
  const packIdLine = lines.find((l) => l && /\*\*Pack ID:\*\*/i.test(l));
  const pack_id = packIdLine && packIdLine.match(/\*\*Pack ID:\*\*\s*(.+)$/i)?.[1] ? packIdLine.match(/\*\*Pack ID:\*\*\s*(.+)$/i)![1].trim().replace(/[`]/g, '') : '';
  const lessonLine = lines.find((l) => l && /\*\*Lesson:\*\*/i.test(l));
  const lesson_id = lessonLine && lessonLine.match(/\*\*Lesson:\*\*\s*(.+)$/i)?.[1] ? lessonLine.match(/\*\*Lesson:\*\*\s*(.+)$/i)![1].trim().replace(/[`]/g, '') : '';
  const cefrLine = lines.find((l) => l && /\*\*CEFR level:\*\*/i.test(l));
  const cefr_level = cefrLine && cefrLine.match(/\*\*CEFR level:\*\*\s*(.+)$/i)?.[1] ? cefrLine.match(/\*\*CEFR level:\*\*\s*(.+)$/i)![1].trim() : 'A2';
  const timeLine = lines.find((l) => l && /\*\*Time cap:\*\*/i.test(l));
  const time_cap = timeLine && timeLine.match(/\*\*Time cap:\*\*\s*(.+)$/i)?.[1] ? parseInt(timeLine.match(/\*\*Time cap:\*\*\s*(.+)$/i)![1]) : 0;
  const splitLine = lines.find((l) => l && /\*\*Split:\*\*/i.test(l));
  const split = splitLine && splitLine.match(/\*\*Split:\*\*\s*(.+)$/i)?.[1] ? splitLine.match(/\*\*Split:\*\*\s*(.+)$/i)![1].trim() : 'mixed';
  const interleaved = /\*\*Interleaved:\*\*\s*yes/i.test(markdown);
  const reuseLine = lines.find((l) => l && /\*\*Reuse basis:\*\*/i.test(l));
  const reuse_basis = reuseLine && reuseLine.match(/\*\*Reuse basis:\*\*\s*(.+)$/i)?.[1] ? reuseLine.match(/\*\*Reuse basis:\*\*\s*(.+)$/i)![1].trim() : 'cite_only';
  const items: PackItemRecord[] = [];
  const skips: Array<{ item_id: string; reason: string }> = [];
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    if (line && /^###\s+ITEM/i.test(line)) {
      const start = i;
      let end = lines.length;
      for (let j = i + 1; j < lines.length; j++) {
        const l2 = lines[j];
        if (!l2) continue;
        if (/^###\s+ITEM/i.test(l2) || /^##\s/.test(l2)) {
          end = j;
          break;
        }
      }
      const itemBlock = lines.slice(start, end).join('\n');
      const item = parseLegacyItem(itemBlock);
      if (item) {
        items.push(item);
      }
    }
  }
  return { pack_id, lesson_id, title: pack_id, cefr_level, time_cap, split, interleaved, reuse_basis, schema: 'legacy_v1', items, skip_count: skips.length, skips };
}
