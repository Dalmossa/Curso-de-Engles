{
  "name": "its-platform",
  "version": "1.0.0",
  "description": "Intelligent Tutoring System for English Learning — Adaptive learning platform for Brazilian Portuguese speakers with focus on IT professionals.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns /node_modules/ /tests/integration/",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern /tests/integration/",
    "test:bdd": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern /tests/bdd/",
    "test:all": "node scripts/test-all.mjs",
    "db:migrate": "echo 'Use NestJS CLI migration commands'",
    "db:seed": "echo 'Seed command not yet implemented'",
    "domain:check": "node scripts/domain-isolation-check.mjs",
    "rls:check": "node scripts/rls-context-check.mjs",
    "contract:gate": "node scripts/contract-gate.mjs",
    "kong:check": "node scripts/kong-config-check.mjs",
    "test:gate": "node scripts/test-gate.mjs"
  },
  "keywords": [
    "its",
    "adaptive-learning",
    "english",
    "brazilian-portuguese",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.5.5",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "fast-check": "^4.10.2",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.5",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.5",
    "@nestjs/platform-express": "^10.4.5",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "^10.0.2",
    "bullmq": "^6.3.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
