{
  "dashboard": {
    "title": "ITS Platform - Audit Log Dashboard",
    "tags": ["its-platform", "audit", "logs", "security"],
    "timezone": "utc",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "title": "Audit Events Rate",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "datasource": "Loki",
        "targets": [
          {
            "expr": "sum by (event_type) (rate({job=\"its-platform-audit\"} |= \"event_type\" [5m]))",
            "legendFormat": "{{event_type}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "min": 0
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]},
          "tooltip": {"mode": "single", "sort": "none"}
        }
      },
      {
        "title": "Audit Event Types Distribution",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "datasource": "Loki",
        "targets": [
          {
            "expr": "sum by (event_type) (count_over_time({job=\"its-platform-audit\"} |= \"event_type\" [1h]))",
            "legendFormat": "{{event_type}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [{"color": "green", "value": null}]
            }
          }
        },
        "options": {
          "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull"]},
          "tooltip": {"mode": "single"}
        }
      },
      {
        "title": "Authentication Events (Success vs Failure)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "datasource": "Loki",
        "targets": [
          {
            "expr": "sum by (event_type) (rate({job=\"its-platform-audit\"} |= \"event_type\" |~ \"auth_(success|failure)\" [5m]))",
            "legendFormat": "{{event_type}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "min": 0
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]},
          "tooltip": {"mode": "single", "sort": "none"}
        }
      },
      {
        "title": "Access Denied Events",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "datasource": "Loki",
        "targets": [
          {
            "expr": "sum by (learner_id) (rate({job=\"its-platform-audit\"} |= \"event_type\" |~ \"access_denied\" [5m]))",
            "legendFormat": "{{learner_id}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "min": 0
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]},
          "tooltip": {"mode": "single", "sort": "none"}
        }
      },
      {
        "title": "Validation Failures",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "datasource": "Loki",
        "targets": [
          {
            "expr": "sum by (service) (rate({job=\"its-platform-audit\"} |= \"event_type\" |~ \"validation_failure\" [5m]))",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "min": 0
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]},
          "tooltip": {"mode": "single", "sort": "none"}
        }
      },
      {
        "title": "Consent Events (Granted vs Withdrawn)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "datasource": "Loki",
        "targets": [
          {
            "expr": "sum by (event_type) (rate({job=\"its-platform-audit\"} |= \"event_type\" |~ \"consent_(granted|withdrawn)\" [5m]))",
            "legendFormat": "{{event_type}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "min": 0
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]},
          "tooltip": {"mode": "single", "sort": "none"}
        }
      },
      {
        "title": "Audit Chain Verification Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 24},
        "datasource": "Loki",
        "targets": [
          {
            "expr": "count_over_time({job=\"its-platform-audit\"} |= \"chain_verification_failed\" [1h])",
            "legendFormat": "Failures",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "red", "value": 1}
              ]
            }
          }
        },
        "options": {
          "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
          "orientation": "auto",
          "textMode": "value",
          "colorMode": "value"
        }
      },
      {
        "title": "Audit Log Volume",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 24},
        "datasource": "Loki",
        "targets": [
          {
            "expr": "sum(rate({job=\"its-platform-audit\"} [5m]))",
            "legendFormat": "Events/sec",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "min": 0
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]},
          "tooltip": {"mode": "single", "sort": "none"}
        }
      },
      {
        "title": "Recent Audit Events",
        "type": "logs",
        "gridPos": {"h": 16, "w": 24, "x": 0, "y": 32},
        "datasource": "Loki",
        "targets": [
          {
            "expr": "{job=\"its-platform-audit\"} | json | event_type != \"\"",
            "legendFormat": "{{event_type}} - {{learner_id}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {}
          }
        },
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": false,
          "wrap": true,
          "prettifyLogMessage": true,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "order": "Descending",
          "limit": 100
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "event_type",
          "type": "query",
          "datasource": "Loki",
          "query": "label_values({job=\"its-platform-audit\"}, event_type)",
          "refresh": 1,
          "multi": true,
          "includeAll": true,
          "allValue": ".*"
        },
        {
          "name": "learner_id",
          "type": "query",
          "datasource": "Loki",
          "query": "label_values({job=\"its-platform-audit\"}, learner_id)",
          "refresh": 1,
          "multi": true,
          "includeAll": true,
          "allValue": ".*"
        }
      ]
    }
  },
  "overwrite": true
}