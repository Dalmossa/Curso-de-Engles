# ITS Platform Frontend — Environment Variables

# Server-only (never exposed to browser)
# Base URL of NestJS API, including /api/v1 prefix
ITS_API_BASE_URL=http://localhost:3000/api/v1

# Bearer token for API calls (server-side only). Leave empty if not required.
ITS_API_TOKEN=

# Mocked learner identity (UUID). Required until ADR-013 closes.
ITS_LEARNER_ID=00000000-0000-0000-0000-000000000001

# Request timeout in milliseconds (10_000 default)
ITS_API_TIMEOUT_MS=10000

# Upstream base for pre-rendered dialogue clips. Used by the same-origin /media proxy.
# Keep HTTP here when clips are served by the local static server on :3200.
AUDIO_BASE_URL=http://192.168.0.6:3200

# Public (inlined into browser bundle)
# Use https://localhost:3100 or https://192.168.0.6:3100 when running dev:https.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Base URL for pre-rendered dialogue/practice audio clips.
# Recommended for HTTPS dev: /media (same-origin proxy, avoids mixed content).
# HTTP LAN dev may use http://192.168.0.6:3200 directly.
NEXT_PUBLIC_AUDIO_BASE_URL=/media
