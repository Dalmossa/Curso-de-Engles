# ITS Platform - Environment Variables Template
# Copy to .env and fill in values

# Application
APP_NAME="ITS Platform"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Security - GENERATE SECURE VALUES FOR PRODUCTION
# NOTE (A5b): this block is FastAPI-era and is not read by `src/` — the API is a Resource Server
# and holds no signing key (ADR-013 Settled, `CONSTITUTION.md` §4.5). The only two variables the
# process reads today are PORT and CORS_ORIGIN. `ALGORITHM=HS256` in particular is stale and
# contradicts §4.5's pin: token verification is RS256 and the algorithm list is in the code, not
# in the environment (see the OIDC block at the end of this file).
SECRET_KEY=your-super-secret-key-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_HASH_ROUNDS=12

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Database
DATABASE_URL=postgresql://its_user:its_password@localhost:5432/its_platform
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=300
CELERY_WORKER_PREFETCH_MULTIPLIER=4

# Content Repository
CONTENT_REPO_PATH=../content
CONTENT_VERIFY_ON_STARTUP=true

# Adaptive Engine
BKT_LEARN_RATE_DEFAULT=0.3
BKT_GUESS_RATE_DEFAULT=0.2
BKT_SLIP_RATE_DEFAULT=0.1
BKT_MASTERY_THRESHOLD=0.85

IRT_DISCRIMINATION_PRIOR=1.0
IRT_DIFFICULTY_PRIOR=0.0
IRT_CAT_SE_THRESHOLD=0.3
IRT_CAT_MAX_ITEMS=30

FSRS_DESIRED_RETENTION=0.9
FSRS_LEARNING_STEPS=[1, 10]
FSRS_RELEARNING_STEPS=[10]

# Observability
OTEL_SERVICE_NAME=its-platform
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
PROMETHEUS_METRICS_PORT=9090

# External Services
ASR_SERVICE_URL=
ASR_API_KEY=
TTS_SERVICE_URL=
STORAGE_BUCKET=
STORAGE_REGION=

# Audio delivery (ADR-028 §5; P1.13)
# AUDIO_URL_SIGNING_KEY is a KMS-rotated secret in deployed environments — never a literal.
AUDIO_URL_SIGNING_KEY=
# Origin/CDN base for catalogue renders; the only thing that differs dev/staging/prod.
AUDIO_BASE_URL=

# Kong Gateway (declarative config: iac/kong/kong.yml — ADR-030)
KONG_ADMIN_URL=
KONG_PROXY_URL=
KONG_REDIS_HOST=redis-cluster
KONG_REDIS_PORT=6379
KONG_REDIS_DATABASE=2
KONG_REDIS_USERNAME=
KONG_REDIS_PASSWORD=

# Feature Flags
ENABLE_LISTENING_SERVICE=true
ENABLE_PRONUNCIATION_ASR=false
ENABLE_SHADOW_CAT=false
ENABLE_A_B_TESTING=false

# OIDC / JWT verification (ADR-013 Resource Server half; ADR-038 D1/D2)
# The API validates tokens an external IdP issues; it never mints one. All three are required —
# if any is absent the guard denies **every** protected route (401) rather than verifying nothing
# (`src/infrastructure/auth/token-verifier-from-env.ts`). There is deliberately no algorithm
# variable: RS256 is pinned in code (§4.5), because an environment that can weaken a signature
# check is a configuration bug waiting to be exploited.
OIDC_JWKS_URI=
OIDC_ISSUER=
OIDC_AUDIENCE=
