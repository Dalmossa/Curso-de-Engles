{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/nemotron-3.5-lightning-free",
  "small_model": "opencode/big-pickle",
  "autoupdate": false,
  "share": "disabled",
  "instructions": [
    "AGENTS.md"
  ],
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.next/**",
      "**/dist/**",
      "**/.git/**"
    ]
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "ask",
      "rm -rf*": "deny",
      "*.env*": "deny",
      "*.env.example*": "allow",
      "printenv*": "deny",
      "env": "deny"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "environment": {
        "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--browser",
        "chromium",
        "--isolated"
      ],
      "enabled": true
    },
    "postgres-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@microsoft/postgres-mcp",
        "run"
      ],
      "environment": {
        "POSTGRES_MCP_CONNECTION_STRING": "{env:DATABASE_URL}"
      },
      "enabled": false
    }
  },
  "tools": {
    "playwright*": true,
    "firecrawl*": true,
    "postgres-mcp*": true
  }
}